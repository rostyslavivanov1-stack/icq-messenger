<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ua.knure.icq.client.controller.ChatController" style="-fx-background-color: #efe6d5;">
    <left>
        <VBox prefWidth="260.0" spacing="14.0" style="-fx-background-color: #ffc400; -fx-padding: 24;">
            <children>
                <Label text="ICQ Messenger" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;" />
                <Label text="USER NAME" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b5600;" />
                <Label fx:id="usernameLabel" text="User" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;" />
                <TextField fx:id="searchField" promptText="Search user..." prefHeight="36.0" style="-fx-background-color: #fffdf7; -fx-background-radius: 8; -fx-border-radius: 8;" />
                <Label text="Chats" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111111;" />
                <ListView fx:id="usersListView" prefHeight="390.0" style="-fx-background-color: #fffdf7; -fx-background-radius: 8; -fx-border-radius: 8;" />
            </children>
        </VBox>
    </left>
    <center>
        <BorderPane style="-fx-background-color: #fffdf7;">
            <top>
                <HBox prefHeight="72.0" alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 24 0 24; -fx-border-color: transparent transparent #e5dac8 transparent;">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Current chat" style="-fx-font-size: 12px; -fx-text-fill: #8a7b68;" />
                                <Label fx:id="receiverLabel" text="Select user" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #222222;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </top>
            <center>
                <AnchorPane style="-fx-background-color: #fffdf7; -fx-padding: 20;">
                    <children>
                        <TextArea fx:id="messagesArea" editable="false" wrapText="true" layoutX="24.0" layoutY="20.0" prefHeight="390.0" prefWidth="660.0" style="-fx-background-color: #fffdf7; -fx-border-color: transparent; -fx-font-size: 14px;" />
                    </children>
                </AnchorPane>
            </center>
            <bottom>
                <HBox prefHeight="88.0" alignment="CENTER" spacing="14.0" style="-fx-padding: 18 24 18 24; -fx-border-color: #e5dac8 transparent transparent transparent;">
                    <children>
                        <TextField fx:id="messageField" promptText="Type a message..." prefHeight="40.0" prefWidth="560.0" style="-fx-background-color: white; -fx-border-color: #d8d1c5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        <Button fx:id="sendButton" text="SEND" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #ffc400; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>